<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Late Study Review Checklist</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Arial,Helvetica,sans-serif;background:#f4f6f3;color:#26342b}
.container{width:min(900px,92%);margin:auto;padding:50px 0}
.header{margin-bottom:30px}.header h1{margin:0 0 10px;font-size:38px;color:#294d38}.header p{margin:0;color:#69766e}
.summary{display:flex;justify-content:space-between;align-items:center;background:#294d38;color:white;border-radius:16px;padding:22px 25px;margin-bottom:25px}
.summary-label{font-size:14px;opacity:.85}.summary-number{font-size:32px;font-weight:bold;margin-top:3px}
.add-box{background:white;border-radius:16px;padding:25px;margin-bottom:25px;box-shadow:0 5px 20px rgba(0,0,0,.05)}
.add-box h2{margin-top:0;font-size:20px}.date-box{margin-bottom:20px}.date-box label{display:block;margin-bottom:7px;font-size:14px;font-weight:bold}
.input-row{display:grid;grid-template-columns:1fr 160px 110px;gap:12px}
input{width:100%;padding:13px 14px;border:1px solid #d5ddd7;border-radius:9px;font-size:15px;outline:none}
input:focus{border-color:#5c8b6c}
button{border:0;border-radius:9px;background:#5c8b6c;color:white;font-size:15px;font-weight:bold;cursor:pointer;padding:12px 18px}
button:hover{background:#416c50}.error{min-height:22px;margin-top:10px;color:#c44b4b;font-size:14px}
.task-list{display:flex;flex-direction:column;gap:12px}.task{display:flex;align-items:center;gap:15px;background:white;border-radius:14px;padding:18px 20px;box-shadow:0 3px 15px rgba(0,0,0,.04)}
.task-checkbox{width:20px;height:20px;cursor:pointer;accent-color:#5c8b6c}.task-info{flex:1}.task-name{font-size:16px;font-weight:bold}.task-minutes{margin-top:4px;color:#748078;font-size:13px}
.task.completed .task-name{text-decoration:line-through;color:#98a29c}.task.completed .task-minutes{color:#aeb7b1}
.empty{text-align:center;padding:50px 20px;color:#89948d;background:white;border-radius:14px}
.download-box{margin-top:25px;text-align:right}.download-button{background:#294d38}.download-button:hover{background:#1e3929}
@media(max-width:650px){.container{padding:30px 0}.header h1{font-size:30px}.input-row{grid-template-columns:1fr}button{min-height:45px}.summary-number{font-size:26px}.download-box{text-align:center}}
</style>
</head>
<body>
<main class="container">
<header class="header">
<h1>Late Study Review Checklist</h1>
<p>Plan your evening review and keep track of the time you still need.</p>
</header>

<section class="summary">
<div><div class="summary-label">Remaining Study Time</div><div class="summary-number" id="remainingMinutes">0 minutes</div></div>
<div><div class="summary-label">Tasks</div><div class="summary-number" id="taskCount">0</div></div>
</section>

<section class="add-box">
<h2>Add a Review Task</h2>
<div class="date-box">
<label for="studyDate">Study Date</label>
<input type="date" id="studyDate">
</div>
<div class="input-row">
<input type="text" id="taskName" placeholder="e.g. Review AP Economics" maxlength="100">
<input type="number" id="taskMinutes" placeholder="Minutes" min="1" max="180" step="1">
<button id="addButton">Add Task</button>
</div>
<div class="error" id="errorMessage"></div>
</section>

<section id="taskList" class="task-list"></section>

<div class="download-box">
<button class="download-button" id="downloadButton">Download Checklist</button>
</div>
</main>

<script>
/* =========================
   STATE
========================= */
let tasks = [];

/* DOM */
const taskNameInput=document.getElementById("taskName");
const taskMinutesInput=document.getElementById("taskMinutes");
const studyDateInput=document.getElementById("studyDate");
const addButton=document.getElementById("addButton");
const downloadButton=document.getElementById("downloadButton");
const errorMessage=document.getElementById("errorMessage");
const taskList=document.getElementById("taskList");
const remainingMinutes=document.getElementById("remainingMinutes");
const taskCount=document.getElementById("taskCount");

/* STATE: default date */
const today=new Date();
studyDateInput.value=`${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,"0")}-${String(today.getDate()).padStart(2,"0")}`;

/* VALIDATION */
function validateTask(name,minutes){
    if(name.trim()==="") return "Please enter a task name.";
    if(minutes.trim()==="") return "Please enter the number of minutes.";
    const number=Number(minutes);
    if(!Number.isFinite(number)) return "Minutes must be a number.";
    if(!Number.isInteger(number)) return "Minutes must be a whole number.";
    if(number<=0) return "Minutes must be greater than 0.";
    if(number>180) return "Minutes cannot be greater than 180.";
    return "";
}

/* EVENT: add task */
function addTask(){
    const name=taskNameInput.value;
    const minutes=taskMinutesInput.value;
    const error=validateTask(name,minutes);
    if(error!==""){errorMessage.textContent=error;return;}

    /* STATE */
    tasks.push({id:Date.now(),name:name.trim(),minutes:Number(minutes),completed:false});

    taskNameInput.value="";
    taskMinutesInput.value="";
    errorMessage.textContent="";
    taskNameInput.focus();

    /* RENDER */
    render();
}

/* EVENT: toggle completion */
function toggleTask(id){
    tasks=tasks.map(task=>task.id===id?{...task,completed:!task.completed}:task);
    /* RENDER */
    render();
}

/* RENDER: task list + summary */
function render(){
    taskList.innerHTML="";

    if(tasks.length===0){
        const empty=document.createElement("div");
        empty.className="empty";
        empty.textContent="No review tasks yet. Add your first task above.";
        taskList.appendChild(empty);
    }else{
        tasks.forEach(task=>{
            const taskElement=document.createElement("div");
            taskElement.className="task";
            if(task.completed) taskElement.classList.add("completed");

            const checkbox=document.createElement("input");
            checkbox.type="checkbox";
            checkbox.className="task-checkbox";
            checkbox.checked=task.completed;
            checkbox.addEventListener("change",()=>toggleTask(task.id));

            const info=document.createElement("div");
            info.className="task-info";

            const name=document.createElement("div");
            name.className="task-name";
            name.textContent=task.name;

            const mins=document.createElement("div");
            mins.className="task-minutes";
            mins.textContent=`${task.minutes} minutes`;

            info.appendChild(name);
            info.appendChild(mins);
            taskElement.appendChild(checkbox);
            taskElement.appendChild(info);
            taskList.appendChild(taskElement);
        });
    }

    const unfinished=tasks.filter(task=>!task.completed).reduce((total,task)=>total+task.minutes,0);
    remainingMinutes.textContent=`${unfinished} minutes`;
    taskCount.textContent=tasks.length;
}

/* EVENT: download */
function downloadChecklist(){
    if(tasks.length===0){
        errorMessage.textContent="Please add at least one task before downloading.";
        return;
    }

    const date=studyDateInput.value;
    const formattedDate=date?new Date(date+"T00:00:00").toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"}):"No date selected";
    const unfinished=tasks.filter(task=>!task.completed).reduce((total,task)=>total+task.minutes,0);

    let content="LATE STUDY REVIEW CHECKLIST\n============================\n\n";
    content+=`Study Date: ${formattedDate}\n\n`;

    tasks.forEach(task=>{
        content+=`${task.completed?"[DONE]":"[ ]"} ${task.name} — ${task.minutes} minutes\n`;
    });

    content+=`\n----------------------------\nRemaining Study Time: ${unfinished} minutes\n`;

    const blob=new Blob([content],{type:"text/plain"});
    const url=URL.createObjectURL(blob);
    const link=document.createElement("a");
    link.href=url;
    link.download="late-study-checklist.txt";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
}

/* EVENTS */
addButton.addEventListener("click",addTask);
downloadButton.addEventListener("click",downloadChecklist);

taskNameInput.addEventListener("keydown",event=>{
    if(event.key==="Enter") addTask();
});
taskMinutesInput.addEventListener("keydown",event=>{
    if(event.key==="Enter") addTask();
});

taskNameInput.addEventListener("input",()=>errorMessage.textContent="");
taskMinutesInput.addEventListener("input",()=>errorMessage.textContent="");

/* INITIAL RENDER */
render();
</script>
</body>
</html>
