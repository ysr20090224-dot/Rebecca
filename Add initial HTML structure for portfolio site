<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Late Study Review Checklist</title>

    <style>
        /* =========================
           BASIC STYLES
        ========================== */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f6f3;
            color: #26342b;
        }

        .container {
            width: min(900px, 92%);
            margin: 0 auto;
            padding: 50px 0;
        }

        /* Header */

        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            margin: 0 0 10px;
            font-size: 38px;
            color: #294d38;
        }

        .header p {
            margin: 0;
            color: #69766e;
            font-size: 16px;
        }

        /* Summary */

        .summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #294d38;
            color: white;
            border-radius: 16px;
            padding: 22px 25px;
            margin-bottom: 25px;
        }

        .summary-label {
            font-size: 14px;
            opacity: 0.85;
        }

        .summary-number {
            font-size: 32px;
            font-weight: bold;
            margin-top: 3px;
        }

        /* Input area */

        .add-box {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .add-box h2 {
            margin-top: 0;
            margin-bottom: 18px;
            font-size: 20px;
        }

        .input-row {
            display: grid;
            grid-template-columns: 1fr 160px 110px;
            gap: 12px;
        }

        input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #d5ddd7;
            border-radius: 9px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #5c8b6c;
        }

        button {
            border: none;
            border-radius: 9px;
            background: #5c8b6c;
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover {
            background: #416c50;
        }

        /* Error message */

        .error {
            min-height: 22px;
            margin-top: 10px;
            color: #c44b4b;
            font-size: 14px;
        }

        /* Task list */

        .task-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .task {
            display: flex;
            align-items: center;
            gap: 15px;
            background: white;
            border-radius: 14px;
            padding: 18px 20px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.04);
        }

        .task-checkbox {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #5c8b6c;
        }

        .task-info {
            flex: 1;
        }

        .task-name {
            font-size: 16px;
            font-weight: bold;
        }

        .task-minutes {
            margin-top: 4px;
            color: #748078;
            font-size: 13px;
        }

        .task.completed .task-name {
            text-decoration: line-through;
            color: #98a29c;
        }

        .task.completed .task-minutes {
            color: #aeb7b1;
        }

        .empty {
            text-align: center;
            padding: 50px 20px;
            color: #89948d;
            background: white;
            border-radius: 14px;
        }

        /* Mobile */

        @media (max-width: 650px) {
            .container {
                padding: 30px 0;
            }

            .header h1 {
                font-size: 30px;
            }

            .input-row {
                grid-template-columns: 1fr;
            }

            button {
                height: 45px;
            }

            .summary-number {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <main class="container">

        <!-- Header -->
        <header class="header">
            <h1>Late Study Review Checklist</h1>
            <p>
                Plan your evening review and keep track of the time you still need.
            </p>
        </header>


        <!-- =========================
             RENDER: SUMMARY
        ========================== -->

        <section class="summary">
            <div>
                <div class="summary-label">
                    Remaining Study Time
                </div>

                <div class="summary-number" id="remainingMinutes">
                    0 minutes
                </div>
            </div>

            <div>
                <div class="summary-label">
                    Tasks
                </div>

                <div class="summary-number" id="taskCount">
                    0
                </div>
            </div>
        </section>


        <!-- Add task -->
        <section class="add-box">

            <h2>Add a Review Task</h2>

            <div class="input-row">

                <input
                    type="text"
                    id="taskName"
                    placeholder="e.g. Review AP Economics"
                    maxlength="100"
                >

                <input
                    type="number"
                    id="taskMinutes"
                    placeholder="Minutes"
                    min="1"
                    max="180"
                    step="1"
                >

                <button id="addButton">
                    Add Task
                </button>

            </div>

            <div class="error" id="errorMessage"></div>

        </section>


        <!-- =========================
             RENDER: TASK LIST
        ========================== -->

        <section id="taskList" class="task-list">

            <div class="empty" id="emptyMessage">
                No review tasks yet. Add your first task above.
            </div>

        </section>

    </main>


    <script>

        /* ==================================================
           STATE
           The application's data is stored here.
        ================================================== */

        let tasks = [];


        /* ==================================================
           DOM ELEMENTS
        ================================================== */

        const taskNameInput = document.getElementById("taskName");
        const taskMinutesInput = document.getElementById("taskMinutes");
        const addButton = document.getElementById("addButton");

        const errorMessage = document.getElementById("errorMessage");

        const taskList = document.getElementById("taskList");
        const remainingMinutes = document.getElementById("remainingMinutes");
        const taskCount = document.getElementById("taskCount");


        /* ==================================================
           VALIDATION
        ================================================== */

        function validateTask(name, minutes) {

            if (name.trim() === "") {
                return "Please enter a task name.";
            }

            if (minutes.trim() === "") {
                return "Please enter the number of minutes.";
            }

            const number = Number(minutes);

            if (!Number.isFinite(number)) {
                return "Minutes must be a number.";
            }

            if (!Number.isInteger(number)) {
                return "Minutes must be a whole number.";
            }

            if (number <= 0) {
                return "Minutes must be greater than 0.";
            }

            if (number > 180) {
                return "Minutes cannot be greater than 180.";
            }

            return "";
        }


        /* ==================================================
           EVENT
           Add a new task.
        ================================================== */

        function addTask() {

            const name = taskNameInput.value;
            const minutes = taskMinutesInput.value;

            const error = validateTask(name, minutes);

            if (error !== "") {
                errorMessage.textContent = error;
                return;
            }

            /* STATE: add a new task */

            tasks.push({
                id: Date.now(),
                name: name.trim(),
                minutes: Number(minutes),
                completed: false
            });

            /* Clear inputs */

            taskNameInput.value = "";
            taskMinutesInput.value = "";

            errorMessage.textContent = "";

            taskNameInput.focus();

            /* RENDER */

            render();
        }


        /* ==================================================
           EVENT
           Complete / uncomplete a task.
        ================================================== */

        function toggleTask(id) {

            tasks = tasks.map(function(task) {

                if (task.id === id) {
                    return {
                        ...task,
                        completed: !task.completed
                    };
                }

                return task;
            });

            /* RENDER */

            render();
        }


        /* ==================================================
           RENDER
           Draw the task list and summary.
        ================================================== */

        function render() {

            /* Clear current list */

            taskList.innerHTML = "";


            /* If there are no tasks */

            if (tasks.length === 0) {

                const emptyMessage = document.createElement("div");

                emptyMessage.className = "empty";

                emptyMessage.textContent =
                    "No review tasks yet. Add your first task above.";

                taskList.appendChild(emptyMessage);

            } else {

                /* Create every task */

                tasks.forEach(function(task) {

                    const taskElement = document.createElement("div");

                    taskElement.className = "task";

                    if (task.completed) {
                        taskElement.classList.add("completed");
                    }


                    /* Checkbox */

                    const checkbox = document.createElement("input");

                    checkbox.type = "checkbox";
                    checkbox.className = "task-checkbox";
                    checkbox.checked = task.completed;

                    /* EVENT: checkbox change */

                    checkbox.addEventListener("change", function() {
                        toggleTask(task.id);
                    });


                    /* Task information */

                    const taskInfo = document.createElement("div");

                    taskInfo.className = "task-info";


                    const taskName = document.createElement("div");

                    taskName.className = "task-name";
                    taskName.textContent = task.name;


                    const taskMinutes = document.createElement("div");

                    taskMinutes.className = "task-minutes";

                    taskMinutes.textContent =
                        task.minutes + " minutes";


                    taskInfo.appendChild(taskName);
                    taskInfo.appendChild(taskMinutes);


                    taskElement.appendChild(checkbox);
                    taskElement.appendChild(taskInfo);

                    taskList.appendChild(taskElement);

                });
            }


            /* Calculate unfinished minutes */

            const unfinishedMinutes = tasks
                .filter(function(task) {
                    return !task.completed;
                })
                .reduce(function(total, task) {
                    return total + task.minutes;
                }, 0);


            /* Render summary */

            remainingMinutes.textContent =
                unfinishedMinutes + " minutes";

            taskCount.textContent = tasks.length;
        }


        /* ==================================================
           EVENT
           Click "Add Task"
        ================================================== */

        addButton.addEventListener("click", addTask);


        /* ==================================================
           EVENT
           Press Enter to add task
        ================================================== */

        taskMinutesInput.addEventListener("keydown", function(event) {

            if (event.key === "Enter") {
                addTask();
            }

        });

        taskNameInput.addEventListener("keydown", function(event) {

            if (event.key === "Enter") {
                addTask();
            }

        });


        /* ==================================================
           EVENT
           Clear error when user starts typing
        ================================================== */

        taskNameInput.addEventListener("input", function() {
            errorMessage.textContent = "";
        });

        taskMinutesInput.addEventListener("input", function() {
            errorMessage.textContent = "";
        });


        /* ==================================================
           INITIAL RENDER
        ================================================== */

        render();

    </script>

</body>
</html>
